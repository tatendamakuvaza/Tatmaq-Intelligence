{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "enum": [
            "report_pdf",
            "report_xlsx",
            "report_html"
          ],
          "title": "Artifact Type",
          "type": "string"
        },
        "content_type": {
          "title": "Content Type",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_path": {
          "title": "Storage Path",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "title",
        "filename",
        "content_type",
        "storage_path",
        "size_bytes",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a finding came from: enough to recompute it independently.",
      "properties": {
        "columns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "dataset_sha256": {
          "title": "Dataset Sha256",
          "type": "string"
        },
        "dataset_version_id": {
          "format": "uuid",
          "title": "Dataset Version Id",
          "type": "string"
        },
        "exclusions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Exclusions",
          "type": "object"
        },
        "filters": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Filters",
          "type": "array"
        },
        "formula": {
          "default": "",
          "title": "Formula",
          "type": "string"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "rows_excluded": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows Excluded"
        },
        "rows_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows Total"
        },
        "rows_used": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows Used"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "ref",
        "operation",
        "dataset_version_id",
        "dataset_sha256"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "title": "Evidence Ref",
          "type": "string"
        },
        "importance": {
          "default": 50,
          "maximum": 100,
          "minimum": 0,
          "title": "Importance",
          "type": "integer"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "kpi",
            "insight",
            "statistic",
            "quality",
            "limitation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "segment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "title",
        "statement",
        "evidence_ref"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "execution_time_ms": {
          "default": 0,
          "title": "Execution Time Ms",
          "type": "integer"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "records_processed": {
          "default": 0,
          "title": "Records Processed",
          "type": "integer"
        },
        "tokens_input": {
          "default": 0,
          "title": "Tokens Input",
          "type": "integer"
        },
        "tokens_output": {
          "default": 0,
          "title": "Tokens Output",
          "type": "integer"
        }
      },
      "title": "Metrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_key": {
      "enum": [
        "chief_intelligence",
        "data_acquisition",
        "data_cleaning",
        "statistical_analysis",
        "report_generation"
      ],
      "title": "Agent Key",
      "type": "string"
    },
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "assumptions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "metrics": {
      "$ref": "#/$defs/Metrics",
      "default": {
        "execution_time_ms": 0,
        "model_name": null,
        "records_processed": 0,
        "tokens_input": 0,
        "tokens_output": 0
      }
    },
    "outputs": {
      "additionalProperties": true,
      "title": "Outputs",
      "type": "object"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "needs_clarification"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "agent_key",
    "status",
    "summary"
  ],
  "title": "AgentResult",
  "type": "object"
}
