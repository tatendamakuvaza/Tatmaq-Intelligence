# Web app settings. Copy to .env.local for local development.

# Where the Next.js server forwards /api/* (the FastAPI service). Server-side only.
API_PROXY_TARGET=http://127.0.0.1:8000

# Set this to call the API directly from the browser instead of through the proxy,
# for example https://api.tatmaqintelligence.com in production (the API must then list
# this site's origin in CORS_ALLOWED_ORIGINS).
NEXT_PUBLIC_API_BASE_URL=

# Supabase Auth. Leave both empty to use the API's own built-in sign-in (AUTH_MODE=builtin or dev).
# Use the *publishable* key (sb_publishable_...). Never put a secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Largest upload the /api proxy will pass on, in MB. Keep equal to the API's MAX_UPLOAD_MB.
MAX_UPLOAD_MB=50
