# =============================================================================
# TATMAQ Intelligence - server configuration
#
# Copy to .env for local development:   cp .env.example .env
# The API and the worker read this file. Real secrets belong in your hosting
# provider's environment settings and must never be committed to GitHub.
# (The web app has its own, public-only settings: apps/web/.env.example)
# =============================================================================

APP_ENV=development

# Signs upload and download links. Required in production: at least 32 random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# PostgreSQL. The value below matches docker-compose.yml. Any PostgreSQL 15+ works: paste
# the address your provider gives you (Aiven's "Service URI", Supabase's Connect dialog...).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tatmaq
# Connections each process may hold open. On a small database lower both (Aiven's free
# plan allows 20 in all; 3 and 2 fit comfortably).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Web origins allowed to call the API directly, comma-separated (production only;
# locally the web app proxies API calls, so nothing is needed).
CORS_ALLOWED_ORIGINS=

# --- Sign-in -----------------------------------------------------------------
# builtin  = the application's own email-and-password accounts, kept in its database.
#            Needs nothing beyond APP_SECRET_KEY. Sends no email: a forgotten password is
#            reset with  python scripts/accounts.py reset-password someone@example.com
# supabase = verify Supabase Auth tokens
# dev      = builtin with a fixed, published signing secret, so a laptop needs no
#            configuration. Refused when APP_ENV=production.
AUTH_MODE=dev
# Built-in sign-in: false stops strangers creating accounts; you then create them with
#   python scripts/accounts.py create someone@example.com
ALLOW_SIGNUPS=true

# Supabase project (needed when AUTH_MODE=supabase or STORAGE_BACKEND=supabase).
# Supabase is retiring the old "anon" and "service_role" keys: use the publishable and
# secret keys. The old variable names SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are
# still accepted here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Leave empty to use <SUPABASE_URL>/auth/v1
JWT_ISSUER=

# --- File storage -------------------------------------------------------------
# local    = files on disk under STORAGE_LOCAL_DIR (development, or a server with a volume)
# database = files inside PostgreSQL itself: for hosts whose disk is wiped on restart
#            (most free container hosts). They count towards the database's size.
# supabase = a private Supabase Storage bucket
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=
OBJECT_STORAGE_BUCKET=tatmaq-private

# --- AI model (optional) -------------------------------------------------------
# none              = built-in planner and template reports; needs no key
# openai_compatible = any provider with an OpenAI-style API; set AI_BASE_URL for others than OpenAI
# anthropic         = Anthropic's Messages API
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Limits --------------------------------------------------------------------
# On a 512 MB server use MAX_UPLOAD_MB=5 and MAX_ANALYSIS_ROWS=50000 (measured: see
# docs/architecture/overview.md), and leave JOB_MAX_MEMORY_MB at its default.
MAX_UPLOAD_MB=50
# A ceiling, not a promise: very wide or text-heavy files can exhaust memory sooner.
MAX_ANALYSIS_ROWS=1000000
PLAN_MONTHLY_ANALYSIS_JOBS=100
MAX_ACTIVE_JOBS_PER_ORG=5

# --- Background worker ------------------------------------------------------------
WORKER_CONCURRENCY=1
JOB_TIMEOUT_SECONDS=600
# Cap on the address space of the process running one job, so an oversized dataset fails
# that job instead of the whole server. 0 disables it. Address space runs roughly 600 MB
# above the memory actually used: measured, 1024 refuses a 300,000-row file that 1536 handles,
# and 1536 handles 850,000 rows. Keep it below the memory your container really has.
JOB_MAX_MEMORY_MB=1536
JOB_MAX_ATTEMPTS=3

# --- Defaults for new organisations -----------------------------------------------
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=Africa/Harare
# How to read a date like 01/09/2026 when nothing in the data settles it: DMY or MDY
DEFAULT_DATE_ORDER=DMY
